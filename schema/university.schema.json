{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "timezone": {
      "type": "string"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "agenda_url": {
      "type": "string",
      "format": "uri"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "slug",
    "name",
    "country",
    "timezone"
  ],
  "additionalProperties": false,
  "title": "PhD TV university registry entry",
  "description": "One file under universities/. Generated from src/schema/university.ts; do not edit by hand."
}
